# ── Bot ──
BOT_NUMBER_OWNER=6281234567890
BOT_OWNER_NAME=Iyan
BOT_SESSION_NAME=iyan
# Prefix: 1 karakter (.) atau regex (mis. [./!])
BOT_PREFIX=.
# Isi untuk login pairing code (kosongkan untuk QR)
BOT_NUMBER_PAIR=
# Gaya menu: card | image | text
BOT_MENU_STYLE=card

# ── Auto update (GitHub) ──
# Wajib agar auto update aktif. Format pemilik/repo
UPDATE_REPO=
UPDATE_BRANCH=main
# Opsional: repo private / hindari rate limit
GITHUB_TOKEN=
AUTO_UPDATE=true
AUTO_UPDATE_INTERVAL_MIN=60

# ── Lokasi tool & data (opsional, otomatis terdeteksi) ──
# YTDLP_PATH=/usr/local/bin/yt-dlp
# PYTHON_PATH=/usr/bin/python3
# PINTEREST_SCRAPER_PATH=
# BOT_DATA_DIR=./data

# ── Lainnya ──
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
